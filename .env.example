# Copy to .env and fill in. NEVER commit .env — this repository is public.

# --- Runtime -----------------------------------------------------------------
# Relative by default so the application runs from a checkout with no arguments.
# Container paths are supplied by compose in M18, not baked in here.
GW_DATABASE_URL=sqlite://./data/great-wiki.db
# Every attachment's bytes, content-addressed. AGENTS.md rule 5 is not negotiable about
# these two lines being different filesystems in a real deployment: the database, the
# search index and the vectors go on NVMe, and blobs — and ONLY blobs — go on the NFS
# mount (`/mnt/cloud/great-wiki/media/`). Never a database or an object store on NFS.
# The server creates `blobs/` and `tmp/` under this and refuses to start if it cannot.
GW_MEDIA_DIR=./data/media
GW_BIND=127.0.0.1:8092
RUST_LOG=info,gw_api=debug

# --- Development identity ----------------------------------------------------
# Synthesises a signed-in user so private content and admin surfaces are testable
# without a proxy. The application REFUSES TO START if this is set while GW_BIND is
# not a loopback address — see M1 Task 4.
GW_DEV_IDENTITY=sergej:admins

# --- Proxy attestation (production only) -------------------------------------
# Caddy injects this value as the `X-GW-Proxy` header. It is ENFORCED ONLY when GW_BIND
# is not a loopback address: `just dev` has nothing in front of it to add the header, so
# demanding one locally would make development impossible. Where it does apply, every
# request is compared against this value in constant time BEFORE any identity is read —
# a wrong value or no header at all is 403, and an empty secret here is 503 rather than
# an open door. The application also refuses to start on a non-loopback bind with this
# unset, because Caddy is on another host and that port is LAN-reachable.
GW_PROXY_SECRET=

# --- OpenID Connect (M2) -----------------------------------------------------
# All four or none. Three of the four is not "OIDC with a default for the fourth" — the
# application REFUSES TO START rather than redirect somebody to a login it cannot finish.
# With none of them set, /auth/login answers 503 and only local accounts can sign in.
#
# GW_OIDC_REDIRECT_URI must be one of the URIs registered with Authelia for the
# `great-wiki` client, character for character: the provider matches it exactly, and a
# mismatch is rejected there rather than here. Registered are
# https://wiki-dev.ohje.ooguy.com/auth/callback and https://wiki.ohje.ooguy.com/auth/callback.
GW_OIDC_ISSUER=https://auth.ohje.ooguy.com
GW_OIDC_CLIENT_ID=great-wiki
GW_OIDC_CLIENT_SECRET=
GW_OIDC_REDIRECT_URI=https://wiki.ohje.ooguy.com/auth/callback

# --- AI (M7) -----------------------------------------------------------------
# LiteLLM only. Never a provider SDK directly, never Ollama as primary.
GW_LLM_BASE_URL=http://192.168.178.159:4000/v1
GW_LLM_MODEL=deepseek-v4-flash
GW_LLM_API_KEY=
GW_EMBEDDING_BASE_URL=http://192.168.178.159:11434/v1
GW_EMBEDDING_MODEL=nomic-embed-text
